{
  "kind": "collectionType",
  "collectionName": "projets",
  "info": {
    "singularName": "projet",
    "pluralName": "projets",
    "displayName": "Projet"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "slug": {
      "type": "uid"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "date": {
      "type": "date"
    },
    "statut": {
      "type": "enumeration",
      "default": "brouillon",
      "enum": [
        "brouillon",
        "pret_a_relire",
        "publie",
        "archive"
      ]
    }
  }
}
