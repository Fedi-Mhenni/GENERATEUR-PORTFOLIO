# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=development
# ⚠️ Passer à "production" avant tout déploiement réel (Raspberry Pi / VPS)

# Secrets Strapi
# Générer avec: openssl rand -base64 32 (ou npx strapi generate)
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
ENCRYPTION_KEY=toBeModified

# Database — source unique de vérité (utilisée par Strapi ET mappée vers
# les POSTGRES_* du conteneur dans docker-compose.yml)
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres_db
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# Port exposé côté hôte (host:5432 conteneur) pour se connecter à la base
# depuis la machine (psql, DBeaver…). Le port interne reste toujours 5432.
DATABASE_HOST_PORT=5432
